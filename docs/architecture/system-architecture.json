    {"id": "s4c", "from": "lead", "to": "outside", "variant": "emphasis", "fromSide": "right", "toSide": "left"},
    {"id": "e1", "from": "inside", "to": "scan", "fromSide": "right", "toSide": "left"},
    {"id": "e2", "from": "inside", "to": "costar", "fromSide": "right", "toSide": "left"},
    {"id": "e3", "from": "paper", "to": "costar", "fromSide": "right", "toSide": "left"},
    {"id": "e4", "from": "paper", "to": "county", "label": "5 evidence", "fromSide": "right", "toSide": "left"},
    {"id": "e5", "from": "outside", "to": "vexcel", "fromSide": "right", "toSide": "left"},
    {"id": "s6", "from": "lead", "to": "judge", "label": "6 judge", "variant": "emphasis", "fromSide": "bottom", "toSide": "top"},
    {"id": "s7", "from": "judge", "to": "cite", "label": "7 cite", "variant": "emphasis", "fromSide": "right", "toSide": "left"},
    {"id": "s8", "from": "cite", "to": "fill", "label": "8 add", "variant": "emphasis", "fromSide": "right", "toSide": "left"},
    {"id": "s9", "from": "server", "to": "runs", "label": "9 save", "fromSide": "bottom", "toSide": "top"},
    {"id": "s10", "from": "runs", "to": "report", "label": "10 render", "fromSide": "bottom", "toSide": "top"},
    {"id": "s11", "from": "ext", "to": "report", "label": "open report", "variant": "dashed", "fromSide": "bottom", "toSide": "left"}
  ],
  "cards": [
    {"dot": "cyan", "title": "In the browser", "items": [
      "The extension finds the address on any rental listing page",
      "One click sends the page text to the local server",
      "Each step streams back live into a side drawer"
    ]},
    {"dot": "emerald", "title": "Agents gather evidence", "items": [
      "A lead agent reads the claims and matches the building",
      "Three checkers work in parallel: inside, paper, outside",
      "Every model call is one headless Claude Code process"
    ]},
    {"dot": "amber", "title": "Rules give the verdict", "items": [
      "The model never decides whether a claim is true",
      "Sources that disagree with each other are not a mismatch",
      "A feature not seen in a photo is reported as can't check"
    ]},
    {"dot": "rose", "title": "What the renter gets", "items": [
      "Each mismatch with its source and a confidence score",
      "The spot in the 3D scan that shows the difference",
      "Questions to ask before the tour"
    ]}
  ]
}
